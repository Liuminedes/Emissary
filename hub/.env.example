# Copia a .env (no se versiona). Sin valores reales aquí.
PORT=3000

# Token que TÚ eliges; se escribe también en el panel de Meta/proveedor al registrar el webhook
WEBHOOK_VERIFY_TOKEN=cambia-esto-por-un-texto-largo-aleatorio

# Autenticación del POST. Usa UNA de las dos:
#  - Meta directo: el App Secret de tu app (valida la firma X-Hub-Signature-256)
META_APP_SECRET=
#  - Proveedor que no firma (ej. 360dialog): un token propio enviado en el header X-Webhook-Token
WEBHOOK_TOKEN=

# Envío de mensajes
# Meta directo:  CLOUD_API_BASE=https://graph.facebook.com/v21.0  CLOUD_AUTH_STYLE=bearer  (requiere CLOUD_PHONE_NUMBER_ID)
# 360dialog:     CLOUD_API_BASE=https://waba-v2.360dialog.io      CLOUD_AUTH_STYLE=d360
CLOUD_API_BASE=
CLOUD_AUTH_STYLE=bearer
CLOUD_API_TOKEN=
CLOUD_PHONE_NUMBER_ID=
